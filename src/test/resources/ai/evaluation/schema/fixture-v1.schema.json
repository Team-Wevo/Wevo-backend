{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wevo.local/schema/ai-evaluation-fixture-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "metadata", "input", "expected"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "feature", "description", "language", "tags", "datasetVersion", "kind", "synthetic"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:/[a-z][a-z0-9-]*)+$", "maxLength": 150 },
        "feature": { "enum": ["ISSUE_DETECTION", "OPINION_SYNTHESIS", "DRAFT_GENERATION", "DRAFT_REVIEW"] },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "language": { "enum": ["ko"] },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 50 }
        },
        "datasetVersion": { "type": "string", "pattern": "^[a-z][a-z0-9-]*-v[1-9][0-9]*$", "maxLength": 100 },
        "kind": { "enum": ["CONTRACT", "QUALITY"] },
        "synthetic": { "type": "boolean" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outputType", "projectContext", "sectionContext", "labels", "opinions", "parentConfirmedContent"],
      "properties": {
        "outputType": { "enum": ["PROPOSAL", "PRESENTATION"] },
        "projectContext": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "sectionContext": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "labels": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "opinions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "content", "submitted", "deleted"],
            "properties": {
              "id": { "type": "string", "pattern": "^opinion-[a-z0-9][a-z0-9-]*$", "maxLength": 100 },
              "content": { "type": "string", "minLength": 1, "maxLength": 100000 },
              "submitted": { "type": "boolean" },
              "deleted": { "type": "boolean" }
            }
          }
        },
        "parentConfirmedContent": { "type": ["string", "null"], "minLength": 1, "maxLength": 20000 }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredFacts", "expectedIssues", "expectedEvidenceIds", "forbiddenClaims", "goldReviewIssueIds"],
      "properties": {
        "requiredFacts": { "$ref": "#/$defs/textList" },
        "expectedIssues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "evidenceIds"],
            "properties": {
              "type": { "enum": ["CONFLICT", "GAP"] },
              "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
            }
          }
        },
        "expectedEvidenceIds": { "$ref": "#/$defs/evidenceIds" },
        "forbiddenClaims": { "$ref": "#/$defs/textList" },
        "goldReviewIssueIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^review-[a-z0-9][a-z0-9-]*$", "maxLength": 100 }
        }
      }
    }
  },
  "$defs": {
    "textList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "evidenceIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^opinion-[a-z0-9][a-z0-9-]*$", "maxLength": 100 }
    }
  }
}
