# 로컬 개발 — docker-compose.yml과 application-local.yml에서 사용
POSTGRES_DB=wevo
POSTGRES_USER=wevo
POSTGRES_PASSWORD=change_me_for_local_development

POSTGRES_PORT=5433
REDIS_PORT=6379

# 익명 검토자 키 쿠키의 Secure 속성. 이 파일은 로컬 .env 로 복사해 쓰므로 false 여야 한다 —
# 로컬은 HTTP 라 켜면 브라우저가 쿠키를 저장하지 않아 중복 제출 차단이 무력화된다.
# 운영은 application-prod.yml 이 기본값 true 라 .env.prod 에 적지 않아도 켜진다.
REVIEW_COOKIE_SECURE=false

# 비인증 외부 검토 제출의 남용 방지. 전부 application.yml 에 기본값이 있어 생략 가능하다.
# IP 기준 값은 두지 않는다 — 제품 정책서 §6.2.4가 공유망 오탐을 이유로 배제한다.
# 남용이 관측되면 한도를 낮추거나 REVIEW_RATE_LIMIT_FAIL_OPEN=false 로 잠근다.
# REVIEW_RATE_LIMIT_LINK_PER_MINUTE=10
# REVIEW_RATE_LIMIT_LINK_PER_HOUR=40
# REVIEW_RATE_LIMIT_FAIL_OPEN=true
# REVIEW_ANOMALY_RAPID_INTERVAL_SECONDS=10
# REVIEW_ANOMALY_RAPID_PAIR_THRESHOLD=3
# REVIEW_ANOMALY_DUPLICATE_SUMMARY_THRESHOLD=2

# 운영 배포 — 실제 값은 EC2 /opt/wevo/.env.prod에만 저장
APP_IMAGE=wevo-backend:local
APP_PORT=8080
DB_URL=jdbc:postgresql://your-rds-endpoint:5432/wevo?sslmode=require
DB_USERNAME=wevo_admin
DB_PASSWORD=change_me_for_production
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=30000
REDIS_HOST=redis
REDIS_PASSWORD=change_me_for_production
REDIS_TIMEOUT=2s
FRONTEND_ORIGIN=https://wevo-official.vercel.app
INVITE_BASE_URL=https://wevo-official.vercel.app/invite/
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -Duser.timezone=Asia/Seoul

# JWT — 최소 32바이트(256bit) 이상의 임의 문자열로 교체
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_bytes

# 초대 토큰 파생용 HMAC 비밀키 — 로컬·운영 모두 필요하다.
# 바꾸면 이미 공유된 초대 링크가 전부 무효가 된다. 팀장이 초대 링크를 다시 발급하면
# 그 프로젝트의 링크는 새 비밀키 기준으로 되살아난다.
INVITE_TOKEN_SECRET=change_me_to_a_long_random_secret_at_least_32_bytes

# 소셜 로그인 OAuth2 (제공자 콘솔에서 발급)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 운영 배포에서는 필수다. 의도적으로 AI를 끌 때만 none을 명시한다.
AI_PROVIDER=openai

# OpenAI 단일 Provider — AI_PROVIDER=openai 일 때 사용
OPENAI_API_KEY=
# /v1이 없는 client root URL. 애플리케이션이 /v1을 정확히 한 번 붙인다.
OPENAI_API_BASE_URL=https://api.openai.com
OPENAI_API_MODEL=gpt-5.6-luna
OPENAI_API_TIMEOUT=60s
OPENAI_API_MAX_TOKENS=4096
OPENAI_API_REASONING_EFFORT=medium
OPENAI_API_CONTEXT_LIMIT=1050000
# false로 즉시 implicit baseline으로 rollback한다.
OPENAI_PROMPT_CACHE_OPTIMIZATION_ENABLED=false
# 측정·승인 뒤 comma-separated 기능 key만 추가한다. 기본값은 explicit 미적용이다.
OPENAI_PROMPT_CACHE_EXPLICIT_FEATURES=
OPENAI_PROMPT_CACHE_EXPLICIT_MODELS=gpt-5.6-luna
OPENAI_PROMPT_CACHE_TTL=30m
OPENAI_INTEGRATION_ENABLED=false
# explicit breakpoint live contract를 별도 opt-in한다.
OPENAI_CACHE_INTEGRATION_ENABLED=false
# 다건 OpenAI 품질 평가 전용 opt-in. smoke와 분리하며 synthetic fixture만 허용한다.
OPENAI_EVALUATION_ENABLED=false
OPENAI_EVALUATION_MAX_FIXTURES=40
OPENAI_EVALUATION_MAX_PROVIDER_REQUESTS=360
OPENAI_EVALUATION_MAX_OUTPUT_TOKENS=120000
OPENAI_EVALUATION_DEADLINE=20m
OPENAI_EVALUATION_MAX_COST_USD=5.00
AI_DEFAULT_MAX_INPUT_TOKENS=100000
AI_SAFETY_MARGIN_TOKENS=8192
AI_ISSUE_DETECTION_MAX_INPUT_TOKENS=64000
AI_OPINION_SYNTHESIS_MAX_INPUT_TOKENS=72000
AI_DRAFT_GENERATION_MAX_INPUT_TOKENS=48000
AI_DRAFT_REVIEW_MAX_INPUT_TOKENS=64000
AI_AUTHOR_INTENT_MAX_INPUT_TOKENS=24000
AI_AUTHOR_INTENT_MAX_OUTPUT_TOKENS=512
AI_REVIEW_INTENT_COMPARISON_MAX_INPUT_TOKENS=12000
AI_REVIEW_INTENT_COMPARISON_MAX_OUTPUT_TOKENS=768
AI_OPINION_CLUSTERING_MAX_INPUT_TOKENS=24000
AI_OPINION_CLUSTERING_MAX_OUTPUT_TOKENS=1024
AI_PROJECT_FLOW_REVIEW_MAX_INPUT_TOKENS=96000
AI_PROJECT_FLOW_REVIEW_MAX_OUTPUT_TOKENS=4096
# Provider SDK 재시도는 0이며, 아래 값은 애플리케이션의 bounded retry 횟수다.
AI_MAX_RETRIES=2
# 구조화 출력 schema 보정 재시도 횟수(최초 호출 제외)
AI_STRUCTURED_OUTPUT_MAX_CORRECTION_RETRIES=2
AI_JOB_MAX_EXECUTIONS_PER_KEY=3
# 모델별 단가 설정과 함께 증가시키는 가격 정책 버전
AI_PRICING_VERSION=openai-2026-07-31-standard

# AI 운영 제어 — false 전환 시 새 AI 실행만 차단되며 조회·비AI 기능은 유지된다.
AI_OPERATIONS_ENABLED=true
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_OPEN_DURATION=30s
AI_CIRCUIT_HALF_OPEN_MAX_CALLS=1

# 운영 AI quota·비용 guardrail (숫자 누락 시 bounded 기본값, provider 사용 시 enabled=true 필수)
AI_GUARDRAIL_ENABLED=true
AI_GUARDRAIL_POLICY_VERSION=ai-guardrail-2026-08-02-v1
AI_GUARDRAIL_RECOVERY_ENABLED=true
AI_GUARDRAIL_RECOVERY_INTERVAL=60s
AI_GUARDRAIL_ORPHAN_GRACE=5m
AI_GUARDRAIL_RECOVERY_BATCH_SIZE=100
AI_QUOTA_USER_PER_MINUTE=6
AI_QUOTA_USER_PER_DAY=100
AI_QUOTA_PROJECT_PER_MINUTE=20
AI_QUOTA_PROJECT_PER_DAY=500
AI_QUOTA_ISSUE_DETECTION_PER_MINUTE=200
AI_QUOTA_ISSUE_DETECTION_PER_DAY=100000
AI_ISSUE_DETECTION_MAX_PROVIDER_REQUESTS=10
AI_QUOTA_OPINION_SYNTHESIS_PER_MINUTE=200
AI_QUOTA_OPINION_SYNTHESIS_PER_DAY=100000
AI_OPINION_SYNTHESIS_MAX_PROVIDER_REQUESTS=11
AI_QUOTA_DRAFT_GENERATION_PER_MINUTE=200
AI_QUOTA_DRAFT_GENERATION_PER_DAY=100000
AI_DRAFT_GENERATION_MAX_PROVIDER_REQUESTS=1
AI_QUOTA_DRAFT_REVIEW_PER_MINUTE=200
AI_QUOTA_DRAFT_REVIEW_PER_DAY=100000
AI_DRAFT_REVIEW_MAX_PROVIDER_REQUESTS=1
AI_QUOTA_AUTHOR_INTENT_PER_MINUTE=200
AI_QUOTA_AUTHOR_INTENT_PER_DAY=100000
AI_AUTHOR_INTENT_MAX_PROVIDER_REQUESTS=1
AI_QUOTA_REVIEW_INTENT_PER_MINUTE=200
AI_QUOTA_REVIEW_INTENT_PER_DAY=100000
AI_REVIEW_INTENT_MAX_PROVIDER_REQUESTS=1
AI_QUOTA_OPINION_CLUSTERING_PER_MINUTE=200
AI_QUOTA_OPINION_CLUSTERING_PER_DAY=100000
AI_OPINION_CLUSTERING_MAX_PROVIDER_REQUESTS=11
AI_QUOTA_PROJECT_FLOW_REVIEW_PER_MINUTE=200
AI_QUOTA_PROJECT_FLOW_REVIEW_PER_DAY=100000
AI_PROJECT_FLOW_REVIEW_MAX_PROVIDER_REQUESTS=36
AI_PROJECT_DAILY_COST_BUDGET_USD=50.000000
AI_PROJECT_MONTHLY_COST_BUDGET_USD=1000.000000
AI_MAX_ESTIMATED_JOB_COST_USD=10.000000
