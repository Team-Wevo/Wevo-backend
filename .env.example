POSTGRES_DB=wevo
POSTGRES_USER=wevo
POSTGRES_PASSWORD=change_me_for_local_development

POSTGRES_PORT=5433
REDIS_PORT=6379

# JWT — 최소 32바이트(256bit) 이상의 임의 문자열로 교체
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_bytes

# 소셜 로그인 OAuth2 (제공자 콘솔에서 발급)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# NVIDIA API Catalog Trial — 로컬 개발·명시적 통합 테스트 전용
AI_PROVIDER=nvidia
NVIDIA_API_KEY=
# Spring AI client root URL이다. 실제 HTTP API base URL은 아래 값에 /v1을 붙인다.
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com
NVIDIA_API_MODEL=moonshotai/kimi-k2.6
NVIDIA_API_TIMEOUT=60s
NVIDIA_API_MAX_TOKENS=4096
NVIDIA_API_TEMPERATURE=1
# 다건 평가 전용 opt-in. smoke의 NVIDIA_INTEGRATION_ENABLED와 분리한다.
NVIDIA_EVALUATION_ENABLED=false
# Provider SDK 재시도는 0이며, 아래 값은 애플리케이션의 bounded retry 횟수다.
AI_MAX_RETRIES=2
# 구조화 출력 schema 보정 재시도 횟수(최초 호출 제외)
AI_STRUCTURED_OUTPUT_MAX_CORRECTION_RETRIES=2
AI_JOB_MAX_EXECUTIONS_PER_KEY=3
# 모델별 단가 설정과 함께 증가시키는 가격 정책 버전
AI_PRICING_VERSION=
