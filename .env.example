POSTGRES_DB=wevo
POSTGRES_USER=wevo
POSTGRES_PASSWORD=change_me_for_local_development

POSTGRES_PORT=5433
REDIS_PORT=6379

# JWT — 최소 32바이트(256bit) 이상의 임의 문자열로 교체
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_bytes

# 소셜 로그인 OAuth2 (제공자 콘솔에서 발급)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Anthropic Claude API (https://console.anthropic.com/ 에서 발급)
ANTHROPIC_API_KEY=
# 모델 ID는 Anthropic 공식 모델 목록에서 선택
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_TIMEOUT=60s
ANTHROPIC_MAX_RETRIES=2
ANTHROPIC_MAX_TOKENS=4096
# 구조화 출력 schema 보정 재시도 횟수(최초 호출 제외)
AI_STRUCTURED_OUTPUT_MAX_CORRECTION_RETRIES=2
AI_JOB_MAX_EXECUTIONS_PER_KEY=3
# 모델별 단가 설정과 함께 증가시키는 가격 정책 버전
AI_PRICING_VERSION=
